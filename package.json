{
  "name": "arca-de-noe",
  "private": true,
  "type": "module",
  "description": "Cada novo seguidor vira um ajudante do Noé na construção da arca em 3D.",
  "scripts": {
    "dev": "node scripts/servidor.mjs 8080",
    "video": "node scripts/gravar-video.mjs",
    "video:trailer": "node scripts/trailer.mjs",
    "video:trailer:audio": "node scripts/trailer.mjs --so-audio",
    "video:02": "node scripts/narracao.mjs --video=02 && node scripts/video02.mjs",
    "video:02:audio": "node scripts/narracao.mjs --video=02 && node scripts/video02.mjs --so-audio",
    "video:03": "node scripts/narracao.mjs --video=03 && node scripts/video03.mjs",
    "video:03:audio": "node scripts/narracao.mjs --video=03 && node scripts/video03.mjs --so-audio",
    "video:pov": "node scripts/narracao.mjs --video=avulso-pov && node scripts/avulso-pov.mjs",
    "video:pov:audio": "node scripts/narracao.mjs --video=avulso-pov && node scripts/avulso-pov.mjs --so-audio",
    "video:04": "node scripts/narracao.mjs --video=04 && node scripts/video04.mjs",
    "video:04:audio": "node scripts/narracao.mjs --video=04 && node scripts/video04.mjs --so-audio"
  }
}
